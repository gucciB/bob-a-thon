{
  "@context": {
    "@vocab": "http://example.org/compliance#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "compliance": "http://example.org/compliance#"
  },
  "@graph": [
    {
      "@id": "compliance:ComplianceAuditOntology",
      "@type": "owl:Ontology",
      "rdfs:label": "Compliance Audit Ontology",
      "rdfs:comment": "An ontology for modeling compliance audits, regulations, policies, gaps, risks, and remediation actions",
      "owl:versionInfo": "1.0.0"
    },
    {
      "@id": "compliance:RegulationClause",
      "@type": "owl:Class",
      "rdfs:label": "Regulation Clause",
      "rdfs:comment": "A specific clause or article within a regulation or standard",
      "rdfs:subClassOf": {
        "@type": "owl:Restriction",
        "owl:onProperty": "compliance:clauseId",
        "owl:cardinality": 1
      }
    },
    {
      "@id": "compliance:clauseId",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Clause ID",
      "rdfs:domain": "compliance:RegulationClause",
      "rdfs:range": "xsd:string",
      "rdfs:comment": "Unique identifier (UUID) for the regulation clause"
    },
    {
      "@id": "compliance:regulationName",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Regulation Name",
      "rdfs:domain": "compliance:RegulationClause",
      "rdfs:range": {
        "@type": "rdfs:Datatype",
        "owl:oneOf": {
          "@list": ["GDPR", "ISO27001", "SOC2", "INTERNAL"]
        }
      },
      "rdfs:comment": "Name of the regulation or standard"
    },
    {
      "@id": "compliance:articleNumber",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Article Number",
      "rdfs:domain": "compliance:RegulationClause",
      "rdfs:range": "xsd:string",
      "rdfs:comment": "Article or section number within the regulation"
    },
    {
      "@id": "compliance:clauseTitle",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Clause Title",
      "rdfs:domain": "compliance:RegulationClause",
      "rdfs:range": "xsd:string",
      "rdfs:comment": "Title of the regulation clause"
    },
    {
      "@id": "compliance:clauseDescription",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Clause Description",
      "rdfs:domain": "compliance:RegulationClause",
      "rdfs:range": "xsd:string",
      "rdfs:comment": "Detailed description of the regulation clause"
    },
    {
      "@id": "compliance:category",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Category",
      "rdfs:domain": "compliance:RegulationClause",
      "rdfs:range": {
        "@type": "rdfs:Datatype",
        "owl:oneOf": {
          "@list": ["DATA_PRIVACY", "ACCESS_CONTROL", "SECURITY", "HR", "CONTRACT"]
        }
      },
      "rdfs:comment": "Category of the regulation clause"
    },
    {
      "@id": "compliance:mandatory",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Mandatory",
      "rdfs:domain": "compliance:RegulationClause",
      "rdfs:range": "xsd:boolean",
      "rdfs:comment": "Indicates whether compliance with this clause is mandatory"
    },
    {
      "@id": "compliance:PolicySection",
      "@type": "owl:Class",
      "rdfs:label": "Policy Section",
      "rdfs:comment": "A section within a policy or contract document",
      "rdfs:subClassOf": {
        "@type": "owl:Restriction",
        "owl:onProperty": "compliance:sectionId",
        "owl:cardinality": 1
      }
    },
    {
      "@id": "compliance:sectionId",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Section ID",
      "rdfs:domain": "compliance:PolicySection",
      "rdfs:range": "xsd:string",
      "rdfs:comment": "Unique identifier (UUID) for the policy section"
    },
    {
      "@id": "compliance:documentName",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Document Name",
      "rdfs:domain": ["compliance:PolicySection", "compliance:AuditDocument"],
      "rdfs:range": "xsd:string",
      "rdfs:comment": "Name of the document"
    },
    {
      "@id": "compliance:sectionTitle",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Section Title",
      "rdfs:domain": "compliance:PolicySection",
      "rdfs:range": "xsd:string",
      "rdfs:comment": "Title of the policy section"
    },
    {
      "@id": "compliance:sectionContent",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Section Content",
      "rdfs:domain": "compliance:PolicySection",
      "rdfs:range": "xsd:string",
      "rdfs:comment": "Content of the policy section"
    },
    {
      "@id": "compliance:documentType",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Document Type",
      "rdfs:domain": ["compliance:PolicySection", "compliance:AuditDocument"],
      "rdfs:range": {
        "@type": "rdfs:Datatype",
        "owl:oneOf": {
          "@list": ["CONTRACT", "SECURITY_POLICY", "HR_POLICY", "GDPR_NOTICE"]
        }
      },
      "rdfs:comment": "Type of the document"
    },
    {
      "@id": "compliance:ComplianceGap",
      "@type": "owl:Class",
      "rdfs:label": "Compliance Gap",
      "rdfs:comment": "A gap or deficiency in compliance with regulations",
      "rdfs:subClassOf": {
        "@type": "owl:Restriction",
        "owl:onProperty": "compliance:gapId",
        "owl:cardinality": 1
      }
    },
    {
      "@id": "compliance:gapId",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Gap ID",
      "rdfs:domain": "compliance:ComplianceGap",
      "rdfs:range": "xsd:string",
      "rdfs:comment": "Unique identifier (UUID) for the compliance gap"
    },
    {
      "@id": "compliance:gapDescription",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Gap Description",
      "rdfs:domain": "compliance:ComplianceGap",
      "rdfs:range": "xsd:string",
      "rdfs:comment": "Description of the compliance gap"
    },
    {
      "@id": "compliance:affectedClause",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Affected Clause",
      "rdfs:domain": "compliance:ComplianceGap",
      "rdfs:range": "compliance:RegulationClause",
      "rdfs:comment": "The regulation clause affected by this gap"
    },
    {
      "@id": "compliance:affectedSection",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Affected Section",
      "rdfs:domain": "compliance:ComplianceGap",
      "rdfs:range": "compliance:PolicySection",
      "rdfs:comment": "The policy section affected by this gap"
    },
    {
      "@id": "compliance:riskLevel",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Risk Level",
      "rdfs:domain": ["compliance:ComplianceGap", "compliance:RiskFinding"],
      "rdfs:range": {
        "@type": "rdfs:Datatype",
        "owl:oneOf": {
          "@list": ["HIGH", "MEDIUM", "LOW"]
        }
      },
      "rdfs:comment": "Level of risk associated with the gap or finding"
    },
    {
      "@id": "compliance:RiskFinding",
      "@type": "owl:Class",
      "rdfs:label": "Risk Finding",
      "rdfs:comment": "A risk finding identified during compliance audit",
      "rdfs:subClassOf": {
        "@type": "owl:Restriction",
        "owl:onProperty": "compliance:findingId",
        "owl:cardinality": 1
      }
    },
    {
      "@id": "compliance:findingId",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Finding ID",
      "rdfs:domain": "compliance:RiskFinding",
      "rdfs:range": "xsd:string",
      "rdfs:comment": "Unique identifier (UUID) for the risk finding"
    },
    {
      "@id": "compliance:findingTitle",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Finding Title",
      "rdfs:domain": "compliance:RiskFinding",
      "rdfs:range": "xsd:string",
      "rdfs:comment": "Title of the risk finding"
    },
    {
      "@id": "compliance:findingDescription",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Finding Description",
      "rdfs:domain": "compliance:RiskFinding",
      "rdfs:range": "xsd:string",
      "rdfs:comment": "Detailed description of the risk finding"
    },
    {
      "@id": "compliance:riskScore",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Risk Score",
      "rdfs:domain": "compliance:RiskFinding",
      "rdfs:range": {
        "@type": "rdfs:Datatype",
        "owl:onDatatype": "xsd:integer",
        "owl:withRestrictions": [
          {
            "xsd:minInclusive": 1
          },
          {
            "xsd:maxInclusive": 10
          }
        ]
      },
      "rdfs:comment": "Numerical risk score from 1 to 10"
    },
    {
      "@id": "compliance:regulationReference",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Regulation Reference",
      "rdfs:domain": "compliance:RiskFinding",
      "rdfs:range": "compliance:RegulationClause",
      "rdfs:comment": "Reference to the regulation clause related to this finding"
    },
    {
      "@id": "compliance:remediationSuggestion",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Remediation Suggestion",
      "rdfs:domain": "compliance:RiskFinding",
      "rdfs:range": "xsd:string",
      "rdfs:comment": "Suggested remediation for the risk finding"
    },
    {
      "@id": "compliance:AuditDocument",
      "@type": "owl:Class",
      "rdfs:label": "Audit Document",
      "rdfs:comment": "A document being audited for compliance",
      "rdfs:subClassOf": {
        "@type": "owl:Restriction",
        "owl:onProperty": "compliance:documentId",
        "owl:cardinality": 1
      }
    },
    {
      "@id": "compliance:documentId",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Document ID",
      "rdfs:domain": "compliance:AuditDocument",
      "rdfs:range": "xsd:string",
      "rdfs:comment": "Unique identifier (UUID) for the audit document"
    },
    {
      "@id": "compliance:uploadDate",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Upload Date",
      "rdfs:domain": "compliance:AuditDocument",
      "rdfs:range": "xsd:dateTime",
      "rdfs:comment": "Date when the document was uploaded"
    },
    {
      "@id": "compliance:auditStatus",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Audit Status",
      "rdfs:domain": "compliance:AuditDocument",
      "rdfs:range": {
        "@type": "rdfs:Datatype",
        "owl:oneOf": {
          "@list": ["PENDING", "IN_PROGRESS", "COMPLETED"]
        }
      },
      "rdfs:comment": "Current status of the audit"
    },
    {
      "@id": "compliance:RemediationAction",
      "@type": "owl:Class",
      "rdfs:label": "Remediation Action",
      "rdfs:comment": "An action to remediate a compliance gap",
      "rdfs:subClassOf": {
        "@type": "owl:Restriction",
        "owl:onProperty": "compliance:actionId",
        "owl:cardinality": 1
      }
    },
    {
      "@id": "compliance:actionId",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Action ID",
      "rdfs:domain": "compliance:RemediationAction",
      "rdfs:range": "xsd:string",
      "rdfs:comment": "Unique identifier (UUID) for the remediation action"
    },
    {
      "@id": "compliance:actionTitle",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Action Title",
      "rdfs:domain": "compliance:RemediationAction",
      "rdfs:range": "xsd:string",
      "rdfs:comment": "Title of the remediation action"
    },
    {
      "@id": "compliance:actionDescription",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Action Description",
      "rdfs:domain": "compliance:RemediationAction",
      "rdfs:range": "xsd:string",
      "rdfs:comment": "Detailed description of the remediation action"
    },
    {
      "@id": "compliance:priority",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Priority",
      "rdfs:domain": "compliance:RemediationAction",
      "rdfs:range": {
        "@type": "rdfs:Datatype",
        "owl:oneOf": {
          "@list": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]
        }
      },
      "rdfs:comment": "Priority level of the remediation action"
    },
    {
      "@id": "compliance:targetClause",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Target Clause",
      "rdfs:domain": "compliance:RemediationAction",
      "rdfs:range": "compliance:RegulationClause",
      "rdfs:comment": "The regulation clause targeted by this remediation action"
    },
    {
      "@id": "compliance:mapsTo",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Maps To",
      "rdfs:domain": "compliance:PolicySection",
      "rdfs:range": "compliance:RegulationClause",
      "rdfs:comment": "Indicates that a policy section maps to a regulation clause"
    },
    {
      "@id": "compliance:identifiedIn",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Identified In",
      "rdfs:domain": "compliance:ComplianceGap",
      "rdfs:range": "compliance:PolicySection",
      "rdfs:comment": "Indicates that a compliance gap was identified in a policy section"
    },
    {
      "@id": "compliance:violates",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Violates",
      "rdfs:domain": "compliance:ComplianceGap",
      "rdfs:range": "compliance:RegulationClause",
      "rdfs:comment": "Indicates that a compliance gap violates a regulation clause"
    },
    {
      "@id": "compliance:containsGap",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Contains Gap",
      "rdfs:domain": "compliance:RiskFinding",
      "rdfs:range": "compliance:ComplianceGap",
      "rdfs:comment": "Indicates that a risk finding contains a compliance gap"
    },
    {
      "@id": "compliance:hasSection",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Has Section",
      "rdfs:domain": "compliance:AuditDocument",
      "rdfs:range": "compliance:PolicySection",
      "rdfs:comment": "Indicates that an audit document has a policy section"
    },
    {
      "@id": "compliance:addressesGap",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Addresses Gap",
      "rdfs:domain": "compliance:RemediationAction",
      "rdfs:range": "compliance:ComplianceGap",
      "rdfs:comment": "Indicates that a remediation action addresses a compliance gap"
    },
    {
      "@id": "compliance:MapSectionToRegulation",
      "@type": "owl:Class",
      "rdfs:label": "Map Section To Regulation Operation",
      "rdfs:comment": "Operation to map a policy section to a regulation clause",
      "rdfs:subClassOf": "compliance:Operation"
    },
    {
      "@id": "compliance:DetectComplianceGap",
      "@type": "owl:Class",
      "rdfs:label": "Detect Compliance Gap Operation",
      "rdfs:comment": "Operation to detect compliance gaps in policy sections",
      "rdfs:subClassOf": "compliance:Operation"
    },
    {
      "@id": "compliance:GenerateRiskFinding",
      "@type": "owl:Class",
      "rdfs:label": "Generate Risk Finding Operation",
      "rdfs:comment": "Operation to generate risk findings from compliance gaps",
      "rdfs:subClassOf": "compliance:Operation"
    },
    {
      "@id": "compliance:RecommendRemediation",
      "@type": "owl:Class",
      "rdfs:label": "Recommend Remediation Operation",
      "rdfs:comment": "Operation to recommend remediation actions for risk findings",
      "rdfs:subClassOf": "compliance:Operation"
    },
    {
      "@id": "compliance:Operation",
      "@type": "owl:Class",
      "rdfs:label": "Operation",
      "rdfs:comment": "Base class for compliance audit operations"
    },
    {
      "@id": "compliance:hasInput",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Has Input",
      "rdfs:domain": "compliance:Operation",
      "rdfs:comment": "Specifies the input entity for an operation"
    },
    {
      "@id": "compliance:hasOutput",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Has Output",
      "rdfs:domain": "compliance:Operation",
      "rdfs:comment": "Specifies the output entity for an operation"
    },
    {
      "@id": "compliance:mapSectionToRegulationInput",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Map Section To Regulation Input",
      "rdfs:domain": "compliance:MapSectionToRegulation",
      "rdfs:range": "compliance:PolicySection",
      "rdfs:subPropertyOf": "compliance:hasInput"
    },
    {
      "@id": "compliance:mapSectionToRegulationOutput",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Map Section To Regulation Output",
      "rdfs:domain": "compliance:MapSectionToRegulation",
      "rdfs:range": "compliance:RegulationClause",
      "rdfs:subPropertyOf": "compliance:hasOutput"
    },
    {
      "@id": "compliance:detectComplianceGapInput",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Detect Compliance Gap Input",
      "rdfs:domain": "compliance:DetectComplianceGap",
      "rdfs:range": "compliance:PolicySection",
      "rdfs:subPropertyOf": "compliance:hasInput"
    },
    {
      "@id": "compliance:detectComplianceGapOutput",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Detect Compliance Gap Output",
      "rdfs:domain": "compliance:DetectComplianceGap",
      "rdfs:range": "compliance:ComplianceGap",
      "rdfs:subPropertyOf": "compliance:hasOutput"
    },
    {
      "@id": "compliance:generateRiskFindingInput",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Generate Risk Finding Input",
      "rdfs:domain": "compliance:GenerateRiskFinding",
      "rdfs:range": "compliance:ComplianceGap",
      "rdfs:subPropertyOf": "compliance:hasInput"
    },
    {
      "@id": "compliance:generateRiskFindingOutput",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Generate Risk Finding Output",
      "rdfs:domain": "compliance:GenerateRiskFinding",
      "rdfs:range": "compliance:RiskFinding",
      "rdfs:subPropertyOf": "compliance:hasOutput"
    },
    {
      "@id": "compliance:recommendRemediationInput",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Recommend Remediation Input",
      "rdfs:domain": "compliance:RecommendRemediation",
      "rdfs:range": "compliance:RiskFinding",
      "rdfs:subPropertyOf": "compliance:hasInput"
    },
    {
      "@id": "compliance:recommendRemediationOutput",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Recommend Remediation Output",
      "rdfs:domain": "compliance:RecommendRemediation",
      "rdfs:range": "compliance:RemediationAction",
      "rdfs:subPropertyOf": "compliance:hasOutput"
    }
  ]
}
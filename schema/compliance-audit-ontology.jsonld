{
  "@context": {
    "compliance": "http://example.org/compliance#",
    "schema": "http://schema.org/",
    "id": "@id",
    "type": "@type",
    "name": "schema:name",
    "description": "schema:description",
    "attributes": "compliance:attributes",
    "identityKey": "compliance:identityKey",
    "humanRef": "compliance:humanRef",
    "invariant": "compliance:invariant",
    "hasState": {
      "@id": "compliance:hasState",
      "@type": "@id"
    },
    "initialState": {
      "@id": "compliance:initialState",
      "@type": "@id"
    },
    "terminalStates": {
      "@id": "compliance:terminalStates",
      "@type": "@id"
    },
    "relatesTo": {
      "@id": "compliance:relatesTo",
      "@type": "@id"
    },
    "emitsEvent": {
      "@id": "compliance:emitsEvent",
      "@type": "@id"
    },
    "from": {
      "@id": "compliance:from",
      "@type": "@id"
    },
    "to": {
      "@id": "compliance:to",
      "@type": "@id"
    },
    "precondition": "compliance:precondition",
    "postcondition": "compliance:postcondition",
    "Entity": "compliance:Entity",
    "Operation": "compliance:Operation",
    "State": "compliance:State"
  },
  "@graph": [
    {
      "id": "compliance:RegulationClause",
      "type": "Entity",
      "name": "RegulationClause",
      "description": "A specific clause or article within a regulation or standard",
      "identityKey": "clauseId: UUID",
      "humanRef": "articleNumber",
      "attributes": {
        "clauseId": "string",
        "regulationName": "GDPR|ISO27001|SOC2|INTERNAL",
        "articleNumber": "string",
        "clauseTitle": "string",
        "clauseDescription": "string",
        "category": "DATA_PRIVACY|ACCESS_CONTROL|SECURITY|HR|CONTRACT",
        "mandatory": "boolean"
      },
      "invariant": [
        "clauseId must be unique",
        "regulationName must be one of: GDPR, ISO27001, SOC2, INTERNAL",
        "category must be one of: DATA_PRIVACY, ACCESS_CONTROL, SECURITY, HR, CONTRACT",
        "mandatory must be a boolean value"
      ],
      "relatesTo": [
        "compliance:PolicySection",
        "compliance:ComplianceGap",
        "compliance:RiskFinding",
        "compliance:RemediationAction"
      ]
    },
    {
      "id": "compliance:PolicySection",
      "type": "Entity",
      "name": "PolicySection",
      "description": "A section within a policy or contract document",
      "identityKey": "sectionId: UUID",
      "humanRef": "sectionTitle",
      "attributes": {
        "sectionId": "string",
        "documentName": "string",
        "sectionTitle": "string",
        "sectionContent": "string",
        "documentType": "CONTRACT|SECURITY_POLICY|HR_POLICY|GDPR_NOTICE"
      },
      "invariant": [
        "sectionId must be unique",
        "documentType must be one of: CONTRACT, SECURITY_POLICY, HR_POLICY, GDPR_NOTICE",
        "sectionContent must not be empty"
      ],
      "hasState": [
        "compliance:PolicySectionPending",
        "compliance:PolicySectionMapped",
        "compliance:PolicySectionAudited"
      ],
      "initialState": "compliance:PolicySectionPending",
      "terminalStates": [
        "compliance:PolicySectionAudited"
      ],
      "relatesTo": [
        "compliance:RegulationClause",
        "compliance:ComplianceGap",
        "compliance:AuditDocument"
      ],
      "emitsEvent": [
        "compliance:PolicySectionMapped",
        "compliance:PolicySectionAudited"
      ]
    },
    {
      "id": "compliance:ComplianceGap",
      "type": "Entity",
      "name": "ComplianceGap",
      "description": "A gap or deficiency in compliance with regulations",
      "identityKey": "gapId: UUID",
      "humanRef": "gapDescription",
      "attributes": {
        "gapId": "string",
        "gapDescription": "string",
        "affectedClause": "string",
        "affectedSection": "string",
        "riskLevel": "HIGH|MEDIUM|LOW"
      },
      "invariant": [
        "gapId must be unique",
        "riskLevel must be one of: HIGH, MEDIUM, LOW",
        "Must reference at least one RegulationClause",
        "Must reference at least one PolicySection"
      ],
      "hasState": [
        "compliance:GapIdentified",
        "compliance:GapAnalyzed",
        "compliance:GapRemediated"
      ],
      "initialState": "compliance:GapIdentified",
      "terminalStates": [
        "compliance:GapRemediated"
      ],
      "relatesTo": [
        "compliance:RegulationClause",
        "compliance:PolicySection",
        "compliance:RiskFinding",
        "compliance:RemediationAction"
      ],
      "emitsEvent": [
        "compliance:GapAnalyzed",
        "compliance:GapRemediated"
      ]
    },
    {
      "id": "compliance:RiskFinding",
      "type": "Entity",
      "name": "RiskFinding",
      "description": "A risk finding identified during compliance audit",
      "identityKey": "findingId: UUID",
      "humanRef": "findingTitle",
      "attributes": {
        "findingId": "string",
        "findingTitle": "string",
        "findingDescription": "string",
        "riskScore": "integer(1-10)",
        "riskLevel": "HIGH|MEDIUM|LOW",
        "regulationReference": "string",
        "remediationSuggestion": "string"
      },
      "invariant": [
        "findingId must be unique",
        "riskScore must be between 1 and 10",
        "riskLevel must be one of: HIGH, MEDIUM, LOW",
        "Must contain at least one ComplianceGap"
      ],
      "hasState": [
        "compliance:FindingDraft",
        "compliance:FindingReviewed",
        "compliance:FindingResolved"
      ],
      "initialState": "compliance:FindingDraft",
      "terminalStates": [
        "compliance:FindingResolved"
      ],
      "relatesTo": [
        "compliance:ComplianceGap",
        "compliance:RegulationClause",
        "compliance:RemediationAction"
      ],
      "emitsEvent": [
        "compliance:FindingReviewed",
        "compliance:FindingResolved"
      ]
    },
    {
      "id": "compliance:AuditDocument",
      "type": "Entity",
      "name": "AuditDocument",
      "description": "A document being audited for compliance",
      "identityKey": "documentId: UUID",
      "humanRef": "documentName",
      "attributes": {
        "documentId": "string",
        "documentName": "string",
        "documentType": "CONTRACT|SECURITY_POLICY|HR_POLICY|GDPR_NOTICE",
        "uploadDate": "dateTime",
        "auditStatus": "PENDING|IN_PROGRESS|COMPLETED"
      },
      "invariant": [
        "documentId must be unique",
        "documentType must be one of: CONTRACT, SECURITY_POLICY, HR_POLICY, GDPR_NOTICE",
        "auditStatus must be one of: PENDING, IN_PROGRESS, COMPLETED",
        "uploadDate must be a valid ISO 8601 dateTime"
      ],
      "hasState": [
        "compliance:AuditPending",
        "compliance:AuditInProgress",
        "compliance:AuditCompleted"
      ],
      "initialState": "compliance:AuditPending",
      "terminalStates": [
        "compliance:AuditCompleted"
      ],
      "relatesTo": [
        "compliance:PolicySection"
      ],
      "emitsEvent": [
        "compliance:AuditInProgress",
        "compliance:AuditCompleted"
      ]
    },
    {
      "id": "compliance:RemediationAction",
      "type": "Entity",
      "name": "RemediationAction",
      "description": "An action to remediate a compliance gap",
      "identityKey": "actionId: UUID",
      "humanRef": "actionTitle",
      "attributes": {
        "actionId": "string",
        "actionTitle": "string",
        "actionDescription": "string",
        "priority": "CRITICAL|HIGH|MEDIUM|LOW",
        "targetClause": "string"
      },
      "invariant": [
        "actionId must be unique",
        "priority must be one of: CRITICAL, HIGH, MEDIUM, LOW",
        "Must address at least one ComplianceGap"
      ],
      "hasState": [
        "compliance:ActionPlanned",
        "compliance:ActionInProgress",
        "compliance:ActionCompleted"
      ],
      "initialState": "compliance:ActionPlanned",
      "terminalStates": [
        "compliance:ActionCompleted"
      ],
      "relatesTo": [
        "compliance:ComplianceGap",
        "compliance:RegulationClause"
      ],
      "emitsEvent": [
        "compliance:ActionInProgress",
        "compliance:ActionCompleted"
      ]
    },
    {
      "id": "compliance:MapSectionToRegulation",
      "type": "Operation",
      "name": "MapSectionToRegulation",
      "description": "Maps a policy section to relevant regulation clauses",
      "from": "compliance:PolicySection",
      "to": "compliance:RegulationClause",
      "precondition": [
        "PolicySection must exist and have content",
        "RegulationClause must exist in the knowledge base"
      ],
      "postcondition": [
        "PolicySection is mapped to one or more RegulationClauses",
        "Mapping relationship is recorded for audit trail"
      ]
    },
    {
      "id": "compliance:DetectComplianceGap",
      "type": "Operation",
      "name": "DetectComplianceGap",
      "description": "Detects compliance gaps by comparing policy sections against regulation clauses",
      "from": "compliance:PolicySection",
      "to": "compliance:ComplianceGap",
      "precondition": [
        "PolicySection must be mapped to RegulationClauses",
        "RegulationClause requirements must be defined"
      ],
      "postcondition": [
        "ComplianceGaps are identified and documented",
        "Each gap references affected PolicySection and RegulationClause",
        "Risk level is assigned to each gap"
      ]
    },
    {
      "id": "compliance:GenerateRiskFinding",
      "type": "Operation",
      "name": "GenerateRiskFinding",
      "description": "Generates risk findings from identified compliance gaps",
      "from": "compliance:ComplianceGap",
      "to": "compliance:RiskFinding",
      "precondition": [
        "ComplianceGap must be identified and documented",
        "Gap must have assigned risk level"
      ],
      "postcondition": [
        "RiskFinding is created with detailed analysis",
        "Risk score (1-10) is calculated",
        "Remediation suggestions are provided",
        "Finding references source ComplianceGap"
      ]
    },
    {
      "id": "compliance:RecommendRemediation",
      "type": "Operation",
      "name": "RecommendRemediation",
      "description": "Recommends remediation actions for risk findings",
      "from": "compliance:RiskFinding",
      "to": "compliance:RemediationAction",
      "precondition": [
        "RiskFinding must be reviewed and validated",
        "Risk score and level must be assigned"
      ],
      "postcondition": [
        "RemediationAction is created with specific steps",
        "Priority is assigned based on risk level",
        "Action targets specific RegulationClause",
        "Action addresses one or more ComplianceGaps"
      ]
    },
    {
      "id": "compliance:IdentifiedIn",
      "type": "Operation",
      "name": "IdentifiedIn",
      "description": "Links a compliance gap to the policy section where it was identified",
      "from": "compliance:ComplianceGap",
      "to": "compliance:PolicySection",
      "precondition": [
        "ComplianceGap must exist",
        "PolicySection must exist"
      ],
      "postcondition": [
        "Gap is associated with specific PolicySection",
        "Traceability is established for audit purposes"
      ]
    },
    {
      "id": "compliance:Violates",
      "type": "Operation",
      "name": "Violates",
      "description": "Links a compliance gap to the regulation clause it violates",
      "from": "compliance:ComplianceGap",
      "to": "compliance:RegulationClause",
      "precondition": [
        "ComplianceGap must exist",
        "RegulationClause must exist"
      ],
      "postcondition": [
        "Gap is associated with violated RegulationClause",
        "Violation is documented for compliance reporting"
      ]
    },
    {
      "id": "compliance:ContainsGap",
      "type": "Operation",
      "name": "ContainsGap",
      "description": "Links a risk finding to the compliance gaps it contains",
      "from": "compliance:RiskFinding",
      "to": "compliance:ComplianceGap",
      "precondition": [
        "RiskFinding must exist",
        "ComplianceGap must be identified"
      ],
      "postcondition": [
        "RiskFinding contains one or more ComplianceGaps",
        "Relationship enables gap-to-finding traceability"
      ]
    },
    {
      "id": "compliance:HasSection",
      "type": "Operation",
      "name": "HasSection",
      "description": "Links an audit document to its policy sections",
      "from": "compliance:AuditDocument",
      "to": "compliance:PolicySection",
      "precondition": [
        "AuditDocument must be uploaded",
        "Document must be parsed into sections"
      ],
      "postcondition": [
        "AuditDocument contains one or more PolicySections",
        "Sections are available for compliance analysis"
      ]
    },
    {
      "id": "compliance:AddressesGap",
      "type": "Operation",
      "name": "AddressesGap",
      "description": "Links a remediation action to the compliance gaps it addresses",
      "from": "compliance:RemediationAction",
      "to": "compliance:ComplianceGap",
      "precondition": [
        "RemediationAction must be planned",
        "ComplianceGap must be identified"
      ],
      "postcondition": [
        "Action is linked to specific gaps",
        "Gap remediation can be tracked"
      ]
    },
    {
      "id": "compliance:PolicySectionPending",
      "type": "State",
      "name": "PolicySectionPending",
      "description": "Policy section has been extracted but not yet mapped to regulations"
    },
    {
      "id": "compliance:PolicySectionMapped",
      "type": "State",
      "name": "PolicySectionMapped",
      "description": "Policy section has been mapped to relevant regulation clauses"
    },
    {
      "id": "compliance:PolicySectionAudited",
      "type": "State",
      "name": "PolicySectionAudited",
      "description": "Policy section has been fully audited for compliance"
    },
    {
      "id": "compliance:GapIdentified",
      "type": "State",
      "name": "GapIdentified",
      "description": "Compliance gap has been identified but not yet analyzed"
    },
    {
      "id": "compliance:GapAnalyzed",
      "type": "State",
      "name": "GapAnalyzed",
      "description": "Compliance gap has been analyzed and risk assessed"
    },
    {
      "id": "compliance:GapRemediated",
      "type": "State",
      "name": "GapRemediated",
      "description": "Compliance gap has been remediated and closed"
    },
    {
      "id": "compliance:FindingDraft",
      "type": "State",
      "name": "FindingDraft",
      "description": "Risk finding is being drafted and not yet reviewed"
    },
    {
      "id": "compliance:FindingReviewed",
      "type": "State",
      "name": "FindingReviewed",
      "description": "Risk finding has been reviewed and validated"
    },
    {
      "id": "compliance:FindingResolved",
      "type": "State",
      "name": "FindingResolved",
      "description": "Risk finding has been resolved through remediation"
    },
    {
      "id": "compliance:AuditPending",
      "type": "State",
      "name": "AuditPending",
      "description": "Audit document has been uploaded but audit not yet started"
    },
    {
      "id": "compliance:AuditInProgress",
      "type": "State",
      "name": "AuditInProgress",
      "description": "Audit is currently in progress"
    },
    {
      "id": "compliance:AuditCompleted",
      "type": "State",
      "name": "AuditCompleted",
      "description": "Audit has been completed and report generated"
    },
    {
      "id": "compliance:ActionPlanned",
      "type": "State",
      "name": "ActionPlanned",
      "description": "Remediation action has been planned but not yet started"
    },
    {
      "id": "compliance:ActionInProgress",
      "type": "State",
      "name": "ActionInProgress",
      "description": "Remediation action is currently being implemented"
    },
    {
      "id": "compliance:ActionCompleted",
      "type": "State",
      "name": "ActionCompleted",
      "description": "Remediation action has been completed and verified"
    }
  ]
}
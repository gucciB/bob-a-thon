# ============================================
# Compliance Audit Platform - Backend Configuration
# ============================================
# Copy this file to .env and update with your actual values
# DO NOT commit .env file to version control

# ============================================
# Server Configuration
# ============================================
# Port number for the Express server
PORT=5000

# Environment: development, production, or test
NODE_ENV=development

# ============================================
# CORS Configuration
# ============================================
# Allowed origins for Cross-Origin Resource Sharing
# For multiple origins, use comma-separated values
# Example: http://localhost:3000,https://app.example.com
CORS_ORIGIN=http://localhost:3000

# ============================================
# ICA Workflow API Configuration
# ============================================
# IBM ICA (Intelligent Compliance Automation) Workflow API
# Base URL for ICA Workflow API
ICA_API_URL=https://api.ica.ibm.com/workflow

# API Key for authentication with ICA Workflow
# Get this from your IBM Cloud account
ICA_API_KEY=your_ica_api_key_here

# Workflow ID for compliance audit workflow
# This identifies the specific workflow to execute
ICA_WORKFLOW_ID=compliance-audit-workflow

# ============================================
# Data Storage Configuration
# ============================================
# Path to JSON file for storing audit results
# Relative or absolute path
DATA_STORE_PATH=./data/audits.json

# ============================================
# File Upload Configuration
# ============================================
# Maximum file size in bytes (default: 10MB)
# 10485760 bytes = 10 MB
# 52428800 bytes = 50 MB
MAX_FILE_SIZE=10485760

# Directory for temporary file uploads
# Files are deleted after text extraction
UPLOAD_DIR=./uploads

# ============================================
# Logging Configuration (Optional)
# ============================================
# Log level: error, warn, info, debug
# LOG_LEVEL=info

# Log file path
# LOG_FILE_PATH=./logs/app.log

# ============================================
# Security Configuration (Optional)
# ============================================
# JWT secret for authentication (if implementing auth)
# JWT_SECRET=your_jwt_secret_here

# Session secret (if using sessions)
# SESSION_SECRET=your_session_secret_here

# ============================================
# Rate Limiting (Optional)
# ============================================
# Maximum requests per window
# RATE_LIMIT_MAX=100

# Time window in minutes
# RATE_LIMIT_WINDOW=15